# Never commit participant-level data. Data live in data/ (and synthetic/*/data/, regenerated by make_synthetic.R).
data/
synthetic/*/data/
synthetic/*/truth.csv
# Real-data outputs stay in the secure environment until they pass UK Biobank output checks
outputs/*
!outputs/.gitkeep
*.partial/
# Data-like formats anywhere in the tree (allowlisted config files below)
*.csv
*.tsv
*.dat
*.dta
*.parquet
*.feather
*.fst
*.sav
*.rds
*.RData
*.bgen
*.bed
*.bim
*.fam
*.pgen
*.pvar
*.psam
!config/**/*.csv
!config/**/*.tsv
.Rhistory
env/
__pycache__/
